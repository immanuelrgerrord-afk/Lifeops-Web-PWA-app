{
  "expo": {
    "name": "LifeOps",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "backgroundColor": "#0A0A0F"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "name": "LifeOps",
      "shortName": "LifeOps",
      "description": "Personal finance operations",
      "lang": "en",
      "themeColor": "#0A0A0F",
      "backgroundColor": "#0A0A0F",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
