# =============================================================================
# LifeOps — single root configuration (used by Docker Compose and local dev)
# Copy to .env and set your values:
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL (Neon) — backend only ---
# Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Backend ---
PORT=3000
JWT_SECRET=
FRONTEND_ORIGIN=https://lifeops.giops.in

# --- Public domains (Caddy automatic HTTPS) ---
FRONTEND_DOMAIN=lifeops.giops.in
API_DOMAIN=apilifeops.giops.in
ACME_EMAIL=admin@giops.in

# --- Frontend build-time API URL (baked into static bundle) ---
EXPO_PUBLIC_API_URL=https://apilifeops.giops.in

# --- Optional: local Expo dev server port (not used in Docker) ---
EXPO_DEV_PORT=8081
